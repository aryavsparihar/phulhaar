{
  "name": "phulhaar-gallery",
  "description": "Phulhaar Gallery by PAT and J.K. Co. \u2014 the storefront and the artists' studio",
  "private": true,
  "sideEffects": false,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "^22 || ^24"
  },
  "scripts": {
    "dev": "shopify hydrogen dev --codegen",
    "build": "shopify hydrogen build --codegen",
    "preview": "shopify hydrogen preview --build",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "lint:fix": "eslint --no-error-on-unmatched-pattern --fix .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "codegen": "shopify hydrogen codegen && react-router typegen",
    "check:env": "tsx scripts/check-env.ts",
    "shopify:setup": "tsx scripts/shopify-setup.ts",
    "mock:pjk": "tsx mocks/pjk/server.ts"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@shopify/hydrogen": "~2026.4.0",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "isbot": "^5.1.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.4",
    "react-router-dom": "7.18.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "7.4.6",
    "@playwright/test": "^1.56.1",
    "@react-router/dev": "8.5.1",
    "@react-router/fs-routes": "8.5.1",
    "@shopify/cli": "5.0.0",
    "@shopify/hydrogen-codegen": "0.3.3",
    "@shopify/mini-oxygen": "4.2.3",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@shopify/prettier-config": "^1.1.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "graphql-config": "^6.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.0.1",
    "vitest": "^5.0.5"
  }
}
