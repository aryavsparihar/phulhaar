# The environment the end-to-end suite runs the app with.
#
# Committed on purpose. Every value here is a throwaway: the storefront talks to Shopify's hosted
# mock.shop, which needs no token, and the PJK secret is the same placeholder the mock PJK in
# mocks/pjk uses, so the two sides of the signature agree. Nothing here is a real secret, and
# nothing real may ever be put in it -- that is what .env is for, and git refuses that one.
#
# It exists because Hydrogen's dev server reads its environment from a file rather than from the
# process that started it, so the suite cannot simply pass these in.
SESSION_SECRET="e2e-only-session-secret-0000000000000000"
PUBLIC_STORE_DOMAIN="mock.shop"
PJK_BASE_URL="http://localhost:4010"
PJK_SHARED_SECRET="mock-pjk-shared-secret-for-local-dev"
PJK_WEBHOOK_SECRET="mock-pjk-webhook-secret-for-local-dev"
PHULHAAR_SITE_URL="http://localhost:3210"
