# Every environment variable this app reads, with a safe placeholder for each.
#
# Copy it to `.env` (which git refuses) and fill in the real values. `pnpm check:env` fails if
# this file and the schema in `app/lib/env.server.ts` ever disagree, so a new variable has to be
# added in both places.
#
# Nothing in this file is a real secret and nothing real may ever be committed to it. Secrets
# reach a machine by being read straight into the place that needs them, never by passing through
# a chat window or a ticket — docs/SETUP.md shows the `read -s` commands.

# ---------------------------------------------------------------------------
# Hydrogen's own session cookie
# ---------------------------------------------------------------------------

# Signs the storefront session cookie (cart, customer account). At least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET="replace-me-with-at-least-32-random-characters"

# ---------------------------------------------------------------------------
# Shopify Storefront API — public, and safe in the browser bundle
# ---------------------------------------------------------------------------

# The store's myshopify.com domain, or mock.shop to develop with no store at all.
PUBLIC_STORE_DOMAIN="mock.shop"

# The public Storefront API token for the Hydrogen storefront. Read-only.
PUBLIC_STOREFRONT_API_TOKEN=""

# The storefront's id, used by Shopify's analytics. Looks like "gid://shopify/..." or a number.
PUBLIC_STOREFRONT_ID=""

# The domain checkout runs on, so the cart hands over to the right place.
PUBLIC_CHECKOUT_DOMAIN=""

# ---------------------------------------------------------------------------
# Shopify Customer Account API — buyers' own accounts and order history
# ---------------------------------------------------------------------------

PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
PUBLIC_CUSTOMER_ACCOUNT_API_URL=""

# ---------------------------------------------------------------------------
# Shopify Admin API — server only, never in the browser bundle
# ---------------------------------------------------------------------------

# A custom app's Admin API access token. It can write products and files, so it is the most
# dangerous value here. Least-privilege scopes are listed in docs/ARCHITECTURE.md.
PRIVATE_ADMIN_API_TOKEN=""

# The Admin API version this code is written against. Shopify supports each for a year.
PRIVATE_ADMIN_API_VERSION="2026-10"

# ---------------------------------------------------------------------------
# PJK, the identity provider for artists (docs/PJK-INTEGRATION.md)
# ---------------------------------------------------------------------------

# Where PJK lives. Point it at the mock (`pnpm mock:pjk`) for local work.
PJK_BASE_URL="http://localhost:4010"

# The shared secret Phulhaar signs its requests to PJK with (HMAC-SHA256).
PJK_SHARED_SECRET=""

# PJK's public key, in PEM, used to verify the signed token PJK returns after a code is accepted.
# Newlines are written as \n so the value fits on one line.
PJK_PUBLIC_KEY=""

# The shared secret PJK signs its lifecycle webhooks to Phulhaar with. Separate from the one
# above, so a leak of either does not let someone speak in both directions.
PJK_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# The gallery itself
# ---------------------------------------------------------------------------

# Where "Enquire about this work" goes. A plain mailbox, not a ticket system.
PHULHAAR_ENQUIRY_EMAIL="hello@phulhaargallery.com"

# The site's own public origin, used for canonical URLs, sitemaps and JSON-LD.
PHULHAAR_SITE_URL="http://localhost:3000"
